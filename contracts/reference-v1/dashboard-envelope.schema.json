{
  "$defs": {
    "DashboardSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "evidence_modes": {
          "items": {
            "enum": [
              "live",
              "recorded",
              "synthetic_replay"
            ],
            "type": "string"
          },
          "title": "Evidence Modes",
          "type": "array"
        },
        "quote_modes": {
          "items": {
            "enum": [
              "live",
              "cached_stale",
              "synthetic_replay"
            ],
            "type": "string"
          },
          "title": "Quote Modes",
          "type": "array"
        },
        "execution_mode": {
          "const": "paper",
          "default": "paper",
          "title": "Execution Mode",
          "type": "string"
        },
        "calibration_status": {
          "enum": [
            "heuristic",
            "validated"
          ],
          "title": "Calibration Status",
          "type": "string"
        },
        "streams": {
          "items": {
            "$ref": "#/$defs/SourceStatus"
          },
          "title": "Streams",
          "type": "array"
        },
        "markets": {
          "items": {
            "$ref": "#/$defs/MarketDefinition"
          },
          "title": "Markets",
          "type": "array"
        },
        "quotes": {
          "items": {
            "$ref": "#/$defs/MarketQuote"
          },
          "title": "Quotes",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/EvidenceClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/FeatureSnapshot"
          },
          "title": "Features",
          "type": "array"
        },
        "estimates": {
          "items": {
            "$ref": "#/$defs/ModelEstimate"
          },
          "title": "Estimates",
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/PaperDecision"
          },
          "title": "Decisions",
          "type": "array"
        },
        "orders": {
          "items": {
            "$ref": "#/$defs/PaperOrder"
          },
          "title": "Orders",
          "type": "array"
        },
        "fills": {
          "items": {
            "$ref": "#/$defs/PaperFill"
          },
          "title": "Fills",
          "type": "array"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/Position"
          },
          "title": "Positions",
          "type": "array"
        },
        "receipts": {
          "items": {
            "$ref": "#/$defs/Receipt"
          },
          "title": "Receipts",
          "type": "array"
        },
        "cash_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cash Usd"
        },
        "equity_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Equity Usd"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "generated_at",
        "evidence_modes",
        "quote_modes",
        "calibration_status",
        "cash_usd",
        "equity_usd"
      ],
      "title": "DashboardSnapshot",
      "type": "object"
    },
    "EvidenceClaim": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "supersedes_claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Claim Id"
        },
        "window_id": {
          "title": "Window Id",
          "type": "string"
        },
        "stream_id": {
          "title": "Stream Id",
          "type": "string"
        },
        "game_id": {
          "title": "Game Id",
          "type": "string"
        },
        "evidence_mode": {
          "enum": [
            "live",
            "recorded",
            "synthetic_replay"
          ],
          "title": "Evidence Mode",
          "type": "string"
        },
        "event_at": {
          "format": "date-time",
          "title": "Event At",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "source_modality": {
          "enum": [
            "speech",
            "chat",
            "emotes",
            "visual_context"
          ],
          "title": "Source Modality",
          "type": "string"
        },
        "aspect": {
          "enum": [
            "narrative",
            "gameplay",
            "presentation",
            "technical_quality",
            "online_experience",
            "overall",
            "irrelevant_unclear"
          ],
          "title": "Aspect",
          "type": "string"
        },
        "subaspect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subaspect"
        },
        "target": {
          "enum": [
            "game",
            "scene",
            "streamer_skill",
            "story_character",
            "streamer_or_chat",
            "unrelated",
            "ambiguous"
          ],
          "title": "Target",
          "type": "string"
        },
        "sentiment": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentiment"
        },
        "defect_severity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Defect Severity"
        },
        "explicitness": {
          "enum": [
            "explicit",
            "contextual",
            "unclear"
          ],
          "title": "Explicitness",
          "type": "string"
        },
        "extraction_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Extraction Confidence",
          "type": "number"
        },
        "attribution_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Attribution Confidence",
          "type": "number"
        },
        "supporting_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supporting Quote"
        },
        "abstention_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstention Reason"
        },
        "scene_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "dependency_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Group Id"
        },
        "extractor_version": {
          "title": "Extractor Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "claim_id",
        "window_id",
        "stream_id",
        "game_id",
        "evidence_mode",
        "event_at",
        "available_at",
        "source_modality",
        "aspect",
        "target",
        "explicitness",
        "extraction_confidence",
        "attribution_confidence",
        "extractor_version"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "FeatureSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "game_id": {
          "title": "Game Id",
          "type": "string"
        },
        "aspect": {
          "enum": [
            "narrative",
            "gameplay",
            "presentation",
            "technical_quality",
            "online_experience",
            "overall",
            "irrelevant_unclear"
          ],
          "title": "Aspect",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "absolute_sentiment": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absolute Sentiment"
        },
        "mean_z": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Z"
        },
        "defect_severity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Defect Severity"
        },
        "baseline_ready": {
          "title": "Baseline Ready",
          "type": "boolean"
        },
        "valid_stream_count": {
          "minimum": 0,
          "title": "Valid Stream Count",
          "type": "integer"
        },
        "independent_group_count": {
          "minimum": 0,
          "title": "Independent Group Count",
          "type": "integer"
        },
        "scene_count": {
          "minimum": 0,
          "title": "Scene Count",
          "type": "integer"
        },
        "effective_source_diagnostic": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Source Diagnostic"
        },
        "disagreement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disagreement"
        },
        "coverage_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Note"
        },
        "baseline_version": {
          "title": "Baseline Version",
          "type": "string"
        },
        "evidence_modes": {
          "items": {
            "enum": [
              "live",
              "recorded",
              "synthetic_replay"
            ],
            "type": "string"
          },
          "title": "Evidence Modes",
          "type": "array"
        },
        "features": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Features",
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "feature_id",
        "game_id",
        "aspect",
        "as_of",
        "claim_ids",
        "baseline_ready",
        "valid_stream_count",
        "independent_group_count",
        "scene_count",
        "baseline_version",
        "evidence_modes"
      ],
      "title": "FeatureSnapshot",
      "type": "object"
    },
    "MarketDefinition": {
      "additionalProperties": false,
      "properties": {
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "event_ticker": {
          "title": "Event Ticker",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "game_id": {
          "title": "Game Id",
          "type": "string"
        },
        "rules_primary": {
          "title": "Rules Primary",
          "type": "string"
        },
        "rules_secondary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rules Secondary"
        },
        "rules_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rules Url"
        },
        "market_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Url"
        },
        "closes_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closes At"
        },
        "outcome_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Group"
        },
        "constraint": {
          "default": "binary",
          "enum": [
            "binary",
            "threshold",
            "exclusive_winner"
          ],
          "title": "Constraint",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "definition_version": {
          "title": "Definition Version",
          "type": "string"
        }
      },
      "required": [
        "ticker",
        "event_ticker",
        "title",
        "game_id",
        "rules_primary",
        "definition_version"
      ],
      "title": "MarketDefinition",
      "type": "object"
    },
    "MarketQuote": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "quote_id": {
          "title": "Quote Id",
          "type": "string"
        },
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "quote_mode": {
          "enum": [
            "live",
            "cached_stale",
            "synthetic_replay"
          ],
          "title": "Quote Mode",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "venue_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue Timestamp"
        },
        "venue_status": {
          "title": "Venue Status",
          "type": "string"
        },
        "is_stale": {
          "title": "Is Stale",
          "type": "boolean"
        },
        "yes_bid": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yes Bid"
        },
        "yes_ask": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yes Ask"
        },
        "no_bid": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Bid"
        },
        "no_ask": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Ask"
        },
        "yes_ask_quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yes Ask Quantity"
        },
        "no_ask_quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Ask Quantity"
        },
        "yes_bid_quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yes Bid Quantity"
        },
        "no_bid_quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Bid Quantity"
        },
        "yes_ask_depth": {
          "items": {
            "$ref": "#/$defs/QuoteLevel"
          },
          "title": "Yes Ask Depth",
          "type": "array"
        },
        "no_ask_depth": {
          "items": {
            "$ref": "#/$defs/QuoteLevel"
          },
          "title": "No Ask Depth",
          "type": "array"
        },
        "yes_bid_depth": {
          "items": {
            "$ref": "#/$defs/QuoteLevel"
          },
          "title": "Yes Bid Depth",
          "type": "array"
        },
        "no_bid_depth": {
          "items": {
            "$ref": "#/$defs/QuoteLevel"
          },
          "title": "No Bid Depth",
          "type": "array"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "quote_id",
        "ticker",
        "quote_mode",
        "captured_at",
        "available_at",
        "venue_status",
        "is_stale",
        "source_ref"
      ],
      "title": "MarketQuote",
      "type": "object"
    },
